{
  "name": "@prjct.app/pi-sync",
  "version": "0.3.0",
  "description": "Back up and restore complete portable Pi setups between machines, including automatic extension and package installation. Never uploads auth or sessions.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "sync",
    "config"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-sync/main/docs/cover.png"
  },
  "scripts": {
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ index.ts || (echo 'Use const and immutable values: no let bindings in src/ or index.ts' && exit 1)",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.ts",
    "src",
    "docs/cover.png",
    "docs/deployment.md"
  ],
  "exports": {
    ".": "./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-sync.git"
  },
  "homepage": "https://github.com/prjct-app/pi-sync#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.5"
  }
}
